library(dplyr)

api <- function(url, api_key) {
  full_url <- paste0(url, "&api_key=", api_key)
  request <- httr::GET(full_url)
  data <- httr::content(request, as="text") 
  parsed_data <- jsonlite::fromJSON(data) 
  if (!is.null(parsed_data$response$data)) {
    result <- as.data.frame(parsed_data)
    return(result)
  }
  else {
    stop("No data found in API response")
  }
}

